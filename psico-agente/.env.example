# Clave de la API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Resend (resend.com) para avisar por mail al profesional. Se usa la API
# HTTP en vez de SMTP porque varios hostings (Render incluido) bloquean el
# tráfico saliente por los puertos SMTP.
RESEND_API_KEY=re_your_api_key_here
# Opcional. Sin esta variable usa el remitente de sandbox de Resend
# (onboarding@resend.dev), que no requiere dominio propio pero solo
# entrega al mail con el que te registraste en Resend. Si más adelante
# verificás un dominio propio, poné acá una dirección de ese dominio.
# RESEND_FROM=Turnos <turnos@tudominio.com>

# Ruta de la base de datos de turnos (en Render: la del disco persistente)
DB_PATH=./app/data/appointments.db

# Token para consultar /api/admin/appointments (turnos + estado del mail).
# Elegí cualquier string largo y random; sin esta variable el endpoint queda deshabilitado.
ADMIN_TOKEN=your-own-random-secret
